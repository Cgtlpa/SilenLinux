#!/bin/sh

export PATH=/sbin:/bin:/usr/sbin:/usr/bin
export TERM="${TERM:-linux}"

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null

mkdir -p /dev/pts /dev/shm /proc /sys /tmp /run /mnt
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /run 2>/dev/null

echo "Welcome to Silen Linux"

if [ -f /etc/modules ]; then
	echo "Loading kernel modules..."
	while read -r mod; do
		[ -n "$mod" ] && modprobe -q "$mod"
	done < /etc/modules
fi

mkdir -p /run/dbus /run/NetworkManager /var/lib/NetworkManager
echo "Starting D-Bus..."
dbus-daemon --system --nofork >/dev/null 2>&1 &
sleep 1
echo "Starting NetworkManager..."
NetworkManager --no-daemon >/dev/null 2>&1 &

echo
echo "Mounting install medium..."
for dev in /dev/sr0 /dev/sr1 /dev/sr2 /dev/cdrom; do
	[ -b "$dev" ] && mount "$dev" /mnt 2>/dev/null && break
done
if ! mountpoint -q /mnt 2>/dev/null; then
	for dev in /dev/sda1 /dev/sda2 /dev/sdb1 /dev/sdb2 /dev/sdc1 /dev/sdc2 /dev/vda1 /dev/vda2; do
		[ -b "$dev" ] && mount "$dev" /mnt 2>/dev/null && break
	done
fi

stage3=""
for f in /mnt/stage3-*.tar.* /mnt/*.tar.xz; do
	[ -f "$f" ] && stage3="$f" && break
done
if [ -n "$stage3" ]; then
	echo "  install medium mounted at /mnt"
	echo "  found Gentoo stage3: $stage3"
else
	echo "  no stage3 tarball found on the mounted media"
fi

echo
echo "Silen Linux live shell (type exit to power off)"
echo
exec /bin/sh
